__pycache__/
*.py[cod]
.venv/
.python-version.local
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- notebooks ---
.ipynb_checkpoints/

# --- secrets / local ---
.env
*.local.yaml

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

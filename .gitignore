*.csv
*.tsv
*.parquet
*.h5
*.rds
!tests/fixtures/*.csv

# --- experiment outputs ---
runs/*
!runs/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/final_*

